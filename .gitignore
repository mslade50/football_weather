# secrets / local env
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
venv/

# browser / scrape scratch
.browser_profile/
output/
tmp/
*.png

# generated board data (served from R2 in prod)
site/web/data/
# written next to --board-dir by pipeline.build (absolute local paths; never an asset)
site/web/publish_manifest.json
site/worker/.wrangler/
.wrangler/
node_modules/

# generated pipeline data (only data/stadiums*.csv, teams.csv, aliases/, raw/ are tracked)
data/backtest/
data/raw_runs/
# data/state/ (openers, archive_last, wx_last, scrape_baseline) lives in R2 since
# Phase 3; pipeline.yml fetches it before the build and never commits it.
data/state/
data/state.json
data/board/
data/snapshots/
data/publish_manifest.json
data/d1_inserts.sql
data/*.parquet
# build.py default outputs (the tracked copies live at the repo root via --legacy-dir)
data/nfl_weather.csv
data/cfb_weather.xlsx
# generated by pipeline.yml light job
requirements-light.txt

# editor
.claude/
.idea/
.vscode/
